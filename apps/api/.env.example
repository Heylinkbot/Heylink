JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INTEGRATION_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=HeyLink <noreply@example.com>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
